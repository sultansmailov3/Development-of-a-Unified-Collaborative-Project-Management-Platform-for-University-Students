PORT=3000

# Замените на длинную случайную строку. В продакшене задавайте через переменные
# окружения хостинга, а не в файле.
JWT_SECRET=change-me-to-a-long-random-string

# Файл базы данных SQLite.
DB_PATH=data.db

# Папка для загруженных файлов. На хостинге укажите путь внутри тома,
# иначе файлы пропадут при следующем деплое.
# UPLOAD_DIR=/var/data/uploads
